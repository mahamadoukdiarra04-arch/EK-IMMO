Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.+)$ /api/uploads.php?path=$1 [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh)$">
  Require all denied
</FilesMatch>
